# banco onde o ETL grava (local ou Aiven: copie a Service URI do console, com ?sslmode=require)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/atlas

# usuário só leitura do app (criado pelo Terraform); o ETL dá GRANT SELECT para ele
APP_DB_USER=atlas_app

# token da API da Aiven, lido pelo Terraform
TF_VAR_aiven_api_token=
